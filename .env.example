# ---------------------------------------------------------------- Browser
# Firebase web app config (Firebase console → Project settings → Your apps).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------- Server
# Data backend: "firestore" (default) or "memory" (in-process demo data,
# no database needed — auth still uses Firebase).
DATA_BACKEND=firestore

# Firebase Auth + Firestore. Service account for the Admin SDK
# (Project settings → Service accounts).
# Keep the \n escapes in the private key. Not needed with the emulators.
FIREBASE_PROJECT_ID=your-project
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---------------------------------------------------------------- Media (Cloudflare R2)
# Photos and other media live in R2. Without these, an in-memory dev store
# is used (photos vanish on restart). STORAGE_BACKEND=r2|memory to force one.
# R2 dashboard → Manage R2 API tokens (Object Read & Write on the bucket).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Bucket name (R2_BUCKET_NAME also works).
R2_BUCKET=easystay-media
# Public base URL: a custom domain on the bucket (recommended) or its r2.dev URL.
R2_PUBLIC_URL=https://media.example.com

# ---------------------------------------------------------------- Emulators (optional)
# Uncomment all three to run against `npm run emulators`.
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
