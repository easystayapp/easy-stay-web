# ---------------------------------------------------------------- Browser
# Firebase web app config (Firebase console → Project settings → Your apps).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------- Server
# Data backend: "firestore" (default) or "memory" (in-process demo data,
# no database needed — auth still uses Firebase).
DATA_BACKEND=firestore

# Service account for the Admin SDK (Project settings → Service accounts).
# Keep the \n escapes in the private key. Not needed with the emulators.
FIREBASE_PROJECT_ID=your-project
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app

# ---------------------------------------------------------------- Emulators (optional)
# Uncomment all four to run against `npm run emulators`.
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
